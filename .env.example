# ---------------------------------------------------------------------------
# CarBikeKharido.com — environment
# © VidyaLabs. All Rights Reserved.
#
# Copy this file to `.env.local` (and `.env` for Prisma CLI commands).
# The app runs without any of these: it falls back to bundled seed data and
# Wikimedia Commons photography. Fill in what you have.
# ---------------------------------------------------------------------------

# PostgreSQL. Required for admin edits and for `npm run db:push` / `db:seed`.
# Copy this file to `.env` (Prisma CLI) and `.env.local` (Next.js).
DATABASE_URL="postgresql://postgres:password@localhost:5432/carbikekharido?schema=public"

# Admin portal (/admin). Both must be set or the sign-in form stays locked.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# IMAGIN.studio — 360° colour renders. Domain-locked customer key.
# NEXT_PUBLIC_IMAGIN_CUSTOMER_KEY=
# NEXT_PUBLIC_IMAGIN_API_KEY=
# NEXT_PUBLIC_IMAGIN_BASE_URL=https://cdn.imagin.studio/getimage

# MyNewCar India — variant pricing + specifications
# https://www.mynewcar.in/car-data-services
MYNEWCAR_API_KEY=
# MYNEWCAR_API_BASE_URL=https://api.mynewcar.in/v1
# MYNEWCAR_AUTH_HEADER=x-api-key
# MYNEWCAR_AUTH_PREFIX=
# MYNEWCAR_SPECS_PATH=/car-specs
# MYNEWCAR_PRICE_PATH=/car-price

# RapidAPI — API Ninjas technical specs (cars + motorcycles)
# Used by `npm run ingest:rapidapi` and `src/lib/providers/rapidapi.ts`.
# The key is server-side only. Never prefix it with NEXT_PUBLIC_.
RAPIDAPI_KEY=
RAPIDAPI_CARS_HOST=cars-by-api-ninjas.p.rapidapi.com
RAPIDAPI_BIKES_HOST=motorcycles-by-api-ninjas.p.rapidapi.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bearer token for POST /api/ingestion/sync in production.
# INGESTION_SECRET=

# EVOX Images — licensed studio photography (North American coverage)
EVOX_API_KEY=
# EVOX_API_BASE_URL=https://api.evoximages.com/api/v1
# EVOX_AUTH_HEADER=Authorization
# EVOX_AUTH_PREFIX=Bearer
# EVOX_PRODUCT_ID=1

# RTO lookup stub (Surepass / Zoop.one) for the trade-in form
# RTO_LOOKUP_API_KEY=
# RTO_LOOKUP_BASE_URL=
# RTO_LOOKUP_PROVIDER=surepass
